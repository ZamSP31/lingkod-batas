# Leave blank for local development / Wi-Fi testing (auto-resolves host:5000)
# Set to HTTPS backend origin without /api. Public build-time value; redeploy after changes.
# Never put database, JWT, Cloudinary, SMTP or AI secrets in VITE_* variables.
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=


