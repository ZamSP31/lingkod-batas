# ==============================================================================
# Lingkod Batas Backend Environment Template
# Duplicate this file as '.env' and populate with local or production credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Render: NODE_ENV=production and CLIENT_URL=https://your-project.vercel.app
# CLIENT_URL must be one exact origin, without a trailing slash or path.
# Leave PORT unset on Render (it supplies PORT); HOST remains 0.0.0.0.

# ------------------------------------------------------------------------------
# 2. Database (MongoDB Atlas / Local MongoDB)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/lingkod-batas?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Tokens
# ------------------------------------------------------------------------------
# Generate a cryptographically secure key: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-secure-32-character-random-string
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Cloudinary (Cloud Document & Report Storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 5. Email & SMTP Configuration (Transactional OTP & Notifications)
# ------------------------------------------------------------------------------
# Option A: Built-in Gmail Service (Requires Google App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your-service-account@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM="Lingkod Batas" <your-service-account@gmail.com>

# Option B: Custom SMTP Relay (Leave empty if using EMAIL_SERVICE)
# Render Free blocks ports 25, 465 and 587. Use an existing SMTP relay on an
# allowed port (e.g. 2525) if supported, or explicitly choose a paid service.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 6. Planned LLM API Providers (not consumed by the current runtime)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
